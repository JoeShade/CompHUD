//
// TRACKER SCHEME RESOURCE FILE
//
// sections:
//		colors			- all the colors used by the scheme
//		basesettings	- contains settings for app to use to draw controls
//		fonts			- list of all the fonts used by app
//		borders			- description of all the borders

// HUD colours and fixed Quake Live typography precede shared defaults.
#base "clientscheme/colors.res"				//all the colors for various things
#base "clientscheme/alternate fonts/quake.res"
// Shared scheme definitions fill properties not provided above.
#base "../resource/clientscheme/basesettings.res"		//"contains settings for app to use to draw controls"
#base "../resource/clientscheme/fonts.res"				//base fonts
#base "../resource/clientscheme/symbols.res"			//symbols
#base "../resource/clientscheme/borders.res"			//the borders
