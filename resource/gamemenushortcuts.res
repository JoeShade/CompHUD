// RESOURCE: Supplies the two training shortcuts when no native editor override is saved.
"GameMenu"
{
	// PANEL: Launches the locally installed tr_walkway_rc2 training map from its icon-only bottom-row shortcut.
	"WalkwayButton"
	{
		"label"			""
		"command"		"engine map tr_walkway_rc2"
		"subimage"		"replay/thumbnails/comphud/menu/comphud_menu_walkway"
		"tooltip"		"tr_walkway"
		"OnlyAtMenu"	"1"
	}
	// PANEL: Launches the locally installed tyler_rocket_shooting_v3_regen training map from its icon-only bottom-row shortcut.
	"RocketShootingButton"
	{
		"label"			""
		"command"		"engine map tyler_rocket_shooting_v3_regen"
		"subimage"		"replay/thumbnails/comphud/menu/comphud_menu_rocket_shooting"
		"tooltip"		"tlr_rocket_shooting"
		"OnlyAtMenu"	"1"
	}
}
