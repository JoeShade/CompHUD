// RESOURCE: Declares the questnotificationpanel base VGUI control tree that TF2 loads for this interface.
"Resource/UI/QuestNotificationPanel_base.res"
{
	// PANEL: Groups and positions the child controls that compose the quest notification panel area of the questnotificationpanel base interface. It starts hidden and remains available for runtime state changes.
	"QuestNotificationPanel"
	{
		"ControlName"								"EditablePanel"
		"fieldName"									"QuestNotificationPanel"
		"wide"										"0"
		"tall"										"0"
		"visible"									"0"
	}	
}