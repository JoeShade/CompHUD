// RESOURCE: Declares the controlpointcountdown VGUI control tree that TF2 loads for this interface.
"Resource/UI/ControlPointCountdown.res"
{
	// PANEL: Centres the native unlock countdown in the point square of the compact canvas; proportional inset offsets TF2's full-height bounds.
	"CapCountdownLabel"
	{	
		"ControlName"		"CExLabel"
		"fieldName"		"CapCountdownLabel"
		"font"			"Garm3nFontSmaller"
		"xpos"			"0"
		"ypos"			"0"
		"zpos"			"1"
		"wide"			"30"
		"tall"			"30"
		"autoResize"		"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"wrap"			"0"
		"labelText"		"%capturetime%"
		"textAlignment"		"center"
		"textinsety" "4"
		"use_proportional_insets" "1"
		"fgcolor"		"235 226 202 255"
		"bgcolor"		"235 226 202 255"
	}
}
