#base "base_unavailable_teleport_target.res"

// RESOURCE: Declares the eureka target home unavail VGUI control tree that TF2 loads for this interface.
"Resource/UI/build_menu/dispenser_unavailable.res"
{
	// PANEL: Shows the localized HUD menu teleport base caption in the item name label control.
	"ItemNameLabel"
	{	
		"labelText"		"#Hud_Menu_Teleport_Base"
	}
	
	// PANEL: Shows the configured number label caption in the eureka target home unavail interface.
	"NumberLabel"
	{	
		"labelText"		"1"
	}
}