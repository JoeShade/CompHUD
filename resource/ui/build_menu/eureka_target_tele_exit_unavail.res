#base "base_unavailable_teleport_target.res"

// RESOURCE: Declares the eureka target tele exit unavail VGUI control tree that TF2 loads for this interface.
"Resource/UI/build_menu/tele_exit_unavailable.res"
{
	// PANEL: Shows the localized TF2 object tele exit 360 caption in the item name label control.
	"ItemNameLabel"
	{	
		"labelText"		"#TF_Object_tele_exit_360"
	}
	
	// PANEL: Shows the configured number label caption in the eureka target tele exit unavail interface.
	"NumberLabel"
	{	
		"labelText"		"2"
	}
}