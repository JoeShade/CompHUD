#base "base_unavailable.res"

// RESOURCE: Declares the dispenser unavailable VGUI control tree that TF2 loads for this interface.
"Resource/UI/build_menu/dispenser_unavailable.res"
{
	// PANEL: Shows the localized TF2 object dispenser caption in the item name label control.
	"ItemNameLabel"
	{	
		"labelText"		"#TF_Object_dispenser"
	}
	
	// PANEL: Shows the configured number label caption in the dispenser unavailable interface.
	"NumberLabel"
	{	
		"labelText"		"2"
	}
}