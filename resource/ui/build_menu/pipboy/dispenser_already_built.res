#base "base_already_built.res"

// RESOURCE: Declares the dispenser already built VGUI control tree that TF2 loads for this interface.
"Resource/UI/build_menu/dispenser_already_built.res"
{
	// PANEL: Shows the localized TF2 object dispenser caption in the item name label control.
	"ItemNameLabel"
	{	
		"labelText"		"#TF_Object_dispenser"
	}
	
	// PANEL: Shows the configured number label caption in the dispenser already built interface.
	"NumberLabel"
	{	
		"labelText"		"2"
	}
}