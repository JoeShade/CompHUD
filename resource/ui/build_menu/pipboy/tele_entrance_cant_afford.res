#base "base_cant_afford.res"

// RESOURCE: Declares the tele entrance cant afford VGUI control tree that TF2 loads for this interface.
"Resource/UI/build_menu/tele_entrance_cant_afford.res"
{
	// PANEL: Shows the localized TF2 object tele entrance 360 caption in the item name label control.
	"ItemNameLabel"
	{	
		"labelText"		"#TF_Object_tele_entrance_360"
	}
	
	// PANEL: Shows the configured number label caption in the tele entrance cant afford interface.
	"NumberLabel"
	{	
		"labelText"		"3"
	}
}