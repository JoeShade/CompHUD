#base "base_selectable.res"

// RESOURCE: Declares the tele selectable VGUI control tree that TF2 loads for this interface.
"Resource/UI/build_menu/tele_selectable.res"
{
	// PANEL: Shows the configured item name label caption in the tele selectable interface.
	"ItemNameLabel"
	{	
		"labelText"		"Teleporter"
	}
	
	// PANEL: Shows the configured building icon visual in the tele selectable interface.
	"BuildingIcon"	
	{
		"icon"			"hud_menu_tele_entrance_build"
	}
}