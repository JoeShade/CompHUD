// RESOURCE: Declares the hudtournamentsetup VGUI control tree that TF2 loads for this interface.
"Resource/UI/HudTournamentSetup.res"
{
	// PANEL: Draws the borderless translucent black ready-up backing beneath the team name and readiness buttons.
	"HudTournamentSetupBG"
	{
		"ControlName"		"ScalableImagePanel"
		"fieldName"		"HudTournamentSetupBG"
		"xpos"			"0"
		"ypos"			"0"
		"zpos"			"-1"
		"wide"			"180"
		"tall"			"65"
		"autoResize"		"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"image"			"replay/thumbnails/comphud/tournament_backing"
		"alpha" "255"
		"mouseinputenabled" "0"
		"keyboardinputenabled" "0"


		"src_corner_height"	"20"				// pixels inside the image
		"src_corner_width"	"20"
		
		"draw_corner_width"	"5"				// screen size of the corners ( and sides ), proportional
		"draw_corner_height" 	"5"	
	}

	// PANEL: Displays TF2's live tournament state in the tournamente label readout.
	"TournamentSetupLabel"
	{	
		"ControlName"		"CExLabel"
		"fieldName"		"TournamenteLabel"
		"font"			"Garm3nFontTargetSmall"
		"xpos"			"0"
		"ypos"			"2"
		"zpos"			"1"
		"wide"			"180"
		"tall"			"35"
		"autoResize"		"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"wrap"			"0"
		"fgcolor"			"Garm3nHUDWhite"
		"labelText"		"%tournamentstatelabel%"
		"textAlignment"		"center"
	}

	// PANEL: Mirrors the tournament setup label readout as an offset contrast layer behind the foreground text.
	"TournamentSetupLabelShadow"
	{	
		"ControlName"		"CExLabel"
		"fieldName"		"TournamenteLabelShadow"
		"font"			"Garm3nFontTargetSmall"
		"xpos"			"1"
		"ypos"			"3"
		"zpos"			"1"
		"wide"			"180"
		"tall"			"35"
		"autoResize"		"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"wrap"			"0"
		"fgcolor"			"Garm3nHUDDarkGrey"
		"labelText"		"%tournamentstatelabel%"
		"textAlignment"		"center"
	}

	// PANEL: Shows the localized tournament team name panel caption in the tournament team name label control.
	"TournamentTeamNameLabel"
	{	
		"ControlName"		"Label"
		"fieldName"		"TournamentTeamNameLabel"
		"font"			"Garm3nFontTargetSmaller"
		"xpos"			"87"
		"ypos"			"28"
		"zpos"			"1"
		"wide"			"0"
		"tall"			"15"
		"autoResize"		"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"wrap"			"0"
		"labelText"		"#Tournament_TeamNamePanel"
		"textAlignment"		"west"
	}

	// PANEL: Edits the live team name using a borderless black field after native TextEntry scheme initialization.
	"TournamentNameEdit"
	{
		"ControlName"		"TextEntry"
		"fieldName"		"TournamentNameEdit"
		"xpos"		"72"
		"ypos"		"27"
		"wide"		"38"
		"tall"		"16"
		"autoResize"		"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"tabPosition"		"0"
		"textHidden"		"0"
		"editable"		"1"
		"maxchars"		"5"
		"NumericInputOnly"	"0"
		"unicode"		"0"
		"wrap"			"0"
		"fgcolor_override"		"255 255 255 255"
		"bgcolor_override"	"0 0 0 255"
		"labelText"		"%teamname%"
		"textAlignment"		"west"
		"paintborder" "0"
		"border" "NoBorder"
		// Apply the native scheme first; its ButtonDepressedBorder would otherwise replace NoBorder.
		"IgnoreScheme" "1"
	}

	// PANEL: Keeps the redundant name backing zero-sized and transparent because native EnableInput restores its visibility.
	"HudTournamentNameBG"
	{
		"ControlName"		"CTFImagePanel"
		"fieldName"		"HudTournamentNameBG"
		"xpos"		"72"
		"ypos"		"28"
		"wide"		"0"
		"tall"		"0"
		"zpos"		"0"
		"autoResize"	"0"
		"pinCorner"	"0"
		"visible"	"0"
		"enabled"	"0"
		"fillcolor"	"0 0 0 0"
		"alpha" "0"
		"paintbackground" "0"
		"scaleImage"	"1"
	}

	// PANEL: Marks the team not ready with a red action button and white text across interaction states.
	"TournamentNotReadyButton"
	{
		"ControlName"	"CTFButton"
		"fieldName"		"TournamentNotReadyButton"
		"xpos"		"15"
		"ypos"		"46"
		"wide"		"70"
		"tall"		"14"
		"zpos"		"0"
		"autoResize"	"0"
		"pinCorner"		"2"
		"visible"		"1"
		"enabled"		"1"
		"labelText"		"Not Ready"
		"textAlignment"	"center"
		"dulltext"		"0"
		"brighttext"	"0"
		"command"		"teamnotready"
		"default"		"1"
		"font"			"Garm3nFontTargetSmaller"
		"fgcolor"		"Garm3nHUDWhite"
		"defaultFgColor_override" "255 255 255 255"
		"armedFgColor_override" "255 255 255 255"
		"depressedFgColor_override" "255 255 255 255"
		"selectedFgColor_override" "255 255 255 255"
		"defaultBgColor_override" "210 25 25 255"
		"armedBgColor_override" "240 45 45 255"
		"depressedBgColor_override" "165 15 15 255"
		"selectedBgColor_override" "165 15 15 255"
		"paintborder" "0"
		"border_default" ""
		"border_armed" ""
		"border_depressed" ""
		"paintbackground" "1"
	}

	// PANEL: Marks the team ready with a green action button and white text across interaction states.
	"TournamentReadyButton"
	{
		"ControlName"	"CTFButton"
		"fieldName"		"TournamentReadyButton"
		"xpos"		"96"
		"ypos"		"46"
		"wide"		"70"
		"tall"		"14"
		"zpos"		"0"
		"autoResize"	"0"
		"pinCorner"		"2"
		"visible"		"1"
		"enabled"		"1"
		"labelText"		"Ready"
		"textAlignment"	"center"
		"dulltext"		"0"
		"brighttext"	"0"
		"command"		"teamready" 
		"default"		"1"
		"font"			"Garm3nFontTargetSmaller"
		"fgcolor"		"Garm3nHUDWhite"
		"defaultFgColor_override" "255 255 255 255"
		"armedFgColor_override" "255 255 255 255"
		"depressedFgColor_override" "255 255 255 255"
		"selectedFgColor_override" "255 255 255 255"
		"defaultBgColor_override" "35 145 55 255"
		"armedBgColor_override" "45 175 65 255"
		"depressedBgColor_override" "25 110 40 255"
		"selectedBgColor_override" "25 110 40 255"
		"paintborder" "0"
		"border_default" ""
		"border_armed" ""
		"border_depressed" ""
		"paintbackground" "1"
	}
}
