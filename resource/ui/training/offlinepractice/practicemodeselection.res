// RESOURCE: Applies scoped HUD typography and palette to native training controls while preserving page geometry and runtime actions.
"Resource/training/offlinepractice/practicemodeselection.res"
{
	// PANEL: Paints an opaque off-white rounded backing beneath the native illustration.
	"PracticeArtworkBacking"
	{
		"ControlName" "EditablePanel"
		"fieldName" "PracticeArtworkBacking"
		"proportionalToParent" "1" // Centre within the practice panel, matching native artwork layout.
		"xpos" "c-125"
		"ypos" "25"
		"zpos" "0"
		"wide" "250"
		"tall" "250"
		"visible" "1"
		"enabled" "1"
		"mouseinputenabled" "0"
		"keyboardinputenabled" "0"
		"bgcolor_override" "242 240 234 255"
		"paintbackground" "1"
		"PaintBackgroundType" "2"
		"paintborder" "0"
		"border" ""
	}

	// PANEL: Preserves the current practice-mode illustration and its native horizontal centering.
	"GameModeImagePanel"
	{
		"ControlName"	"ImagePanel"
		"FieldName"		"GameModeImagePanel"
		"xpos"			"60"
		"ypos"			"25"
		"zpos"			"1"
		"wide"			"250"
		"tall"			"250"
		"visible"		"1"
		"tileImage"		"0"
		"scaleImage"	"1"
		"border"		""
		"paintbackgroundtype"	"0"
		"paintbackground"	"1"
		"fillcolor_override" "0 0 0 0" // The separate rounded panel paints beneath this image.
		"paintborder" "0"
	}
	
	// PANEL: Provides a neutral backdrop behind the practice-mode illustration and captions.
	"GameModeImageBgPanel"
	{
		"ControlName"	"ImagePanel"
		"FieldName"		"GameModeImageBgPanel"
		"xpos"			"60"
		"zpos"			"0"
		"wide"			"330"
		"tall"			"255"
		"visible"		"1"
		"tileImage"		"0"
		"scaleImage"	"1"
		"image"			""
		"bgcolor_override" "32 34 36 255"
		"paintbackground" "1"
		"paintborder" "0"
		"border" ""
		"PaintBackgroundType" "0"
	}
	
	// PANEL: Moves to the previous native carousel entry.
	"PrevButton"
	{
		"ControlName"	"CExButton"
		"fieldName"		"PrevButton"
		"xpos"			"36"
		"ypos"			"105"
		"zpos"			"20"
		"wide"			"18"
		"tall"			"43"
		"autoResize"	"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"tabPosition"	"0"
		"labelText"		"#TF_LessThan"
		"font"			"CompHUDMatchmakingAction"
		"textAlignment"	"center"
		"textinsetx"	"0"
		"dulltext"		"0"
		"brighttext"	"0"
		"Command"		"goprev"
		"sound_depressed"	"UI/buttonclick.wav"
		"sound_released"	"UI/buttonclickrelease.wav"
		"paintbackground" "1"
		"paintborder" "0"
		"RoundedCorners" "0"
		"PaintBackgroundType" "0"
		"border_default" ""
		"border_armed" ""
		"border_depressed" ""
		"border_disabled" ""
		"defaultBgColor_override" "54 57 60 255"
		"armedBgColor_override" "225 90 20 255"
		"depressedBgColor_override" "180 70 15 255"
		"disabledBgColor_override" "40 42 44 255"
		"defaultFgColor_override" "255 255 255 255"
		"armedFgColor_override" "255 255 255 255"
		"depressedFgColor_override" "255 255 255 255"
		"disabledFgColor_override" "135 138 141 255"
	}	
	
	// PANEL: Moves to the next native carousel entry.
	"NextButton"
	{
		"ControlName"	"CExButton"
		"fieldName"		"NextButton"
		"xpos"			"396"
		"ypos"			"105"
		"zpos"			"20"
		"wide"			"18"
		"tall"			"43"
		"autoResize"	"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"tabPosition"	"0"
		"labelText"		"#TF_GreaterThan"
		"font"			"CompHUDMatchmakingAction"
		"textAlignment"	"center"
		"textinsetx"	"0"
		"dulltext"		"0"
		"brighttext"	"0"
		"Command"		"gonext"
		"sound_depressed"	"UI/buttonclick.wav"
		"sound_released"	"UI/buttonclickrelease.wav"
		"paintbackground" "1"
		"paintborder" "0"
		"RoundedCorners" "0"
		"PaintBackgroundType" "0"
		"border_default" ""
		"border_armed" ""
		"border_depressed" ""
		"border_disabled" ""
		"defaultBgColor_override" "54 57 60 255"
		"armedBgColor_override" "225 90 20 255"
		"depressedBgColor_override" "180 70 15 255"
		"disabledBgColor_override" "40 42 44 255"
		"defaultFgColor_override" "255 255 255 255"
		"armedFgColor_override" "255 255 255 255"
		"depressedFgColor_override" "255 255 255 255"
		"disabledFgColor_override" "135 138 141 255"
	}	
	
	// PANEL: Displays the localized practice-mode name in the HUD action face.
	"GameModeLabel"
	{
		"ControlName"	"CExLabel"
		"fieldName"		"GameModeLabel"
		"font"			"CompHUDMatchmakingAction"
		"labelText"		"%gamemode%"
		"textAlignment"	"center"
		"xpos"			"60"
		"ypos"			"0"
		"wide"			"330"
		"tall"			"20"
		"autoResize"	"1"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"wrap"			"0"
		"fgcolor_override"	"255 255 255 255"
	}
	
	// PANEL: Shows the current native carousel page count with consistent HUD typography.
	"CurPageLabel"
	{
		"ControlName"	"CExLabel"
		"fieldName"		"CurPageLabel"
		"font"			"CompHUDMatchmakingAction"
		"labelText"		"%curpage%"
		"textAlignment"	"north"
		"xpos"			"70"
		"ypos"			"0"
		"zpos"			"1"
		"wide"			"40"
		"tall"			"20"
		"autoResize"	"1"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"wrap"			"1"
		"fgcolor_override"	"255 255 255 255"
	}
	
	// PANEL: Presents localized training instructions and descriptions within the existing reading area.
	"DescLabel"
	{
		"ControlName"	"CExLabel"
		"fieldName"		"DescLabel"
		"font"			"CompHUDMatchmakingBodySmall"
		"labelText"		"%description%"
		"textAlignment"	"center"
		"xpos"			"60"
		"ypos"			"277"
		"wide"			"330"
		"tall"			"20"
		"autoResize"	"1"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"wrap"			"0"
		"fgcolor_override"	"220 220 220 255"
	}
	
	// PANEL: Opens native map selection for the current practice mode.
	"SelectCurrentGameModeButton"
	{
		"ControlName"		"CExButton"
		"fieldName"			"SelectCurrentGameModeButton"
		"xpos"				"160"
		"ypos"				"300"
		"wide"				"130"
		"tall"				"25"
		"autoResize"		"0"
		"pinCorner"			"0"
		"visible"			"1"
		"enabled"			"1"
		"tabPosition"		"0"
		"labelText"			"#TF_Select"
		"font"				"CompHUDMatchmakingAction"
		"textAlignment"		"center"
		"textinsetx"		"0"
		"dulltext"			"0"
		"brighttext"		"0"
		"Command"			"selectcurrentgamemode"
		"sound_depressed"	"UI/buttonclick.wav"
		"sound_released"	"UI/buttonclickrelease.wav"

		"border_default"	""
		"border_armed"		""
		"paintbackground"	"1"
		
		"defaultFgColor_override" "255 255 255 255"
		"armedFgColor_override" "255 255 255 255"
		"depressedFgColor_override" "255 255 255 255"
		"paintborder" "0"
		"RoundedCorners" "0"
		"PaintBackgroundType" "0"
		"border_depressed" ""
		"border_disabled" ""
		"defaultBgColor_override" "54 57 60 255"
		"armedBgColor_override" "225 90 20 255"
		"depressedBgColor_override" "180 70 15 255"
		"disabledBgColor_override" "40 42 44 255"
		"disabledFgColor_override" "135 138 141 255"
	}
	
}
