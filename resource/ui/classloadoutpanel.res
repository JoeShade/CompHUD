// RESOURCE: Styles class equipment and taunt loadouts while preserving native slots, presets, item semantics, and model controls.
"Resource/UI/FullLoadoutPanel.res"
{
	// PANEL: Hosts native loadout controls on the shared Items charcoal surface.
	"class_loadout_panel"
	{
		"ControlName"	"Frame"
		"fieldName"		"class_loadout_panel"
		"xpos"			"0"
		"ypos"			"0"
		"wide"			"f0"
		"autoResize"	"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"tabPosition"	"0"
		"settitlebarvisible"	"0"
		"PaintBackgroundType"	"0"
		"bgcolor_override"	"32 34 36 255"
		"infocus_bgcolor_override" "32 34 36 255"
		"outoffocus_bgcolor_override" "32 34 36 255"
		
		"item_xpos_offcenter_a"	"-310"
		"item_xpos_offcenter_b"	"165"
		"item_ypos"		"60"
		"item_ydelta"	"75"
		"item_mod_wide"	"40"
		
		"item_backpack_offcenter_x"		"-288"
		"item_backpack_xdelta"			"4"
		"item_backpack_ydelta"			"3"

		"button_xpos_offcenter"	"175"		
		"button_ypos"	"85"
		"button_ydelta"	"80"
		"button_override_delete_xpos" "0"
		
		// PANEL TEMPLATE: Draws the native item card on a square near-black grey fill while preserving item models, quality colours and runtime state bindings.
		"modelpanels_kv"
		{
			"ControlName"	"CItemModelPanel"
			"xpos"			"c-70"
			"ypos"			"270"
			"wide"			"140"
			"tall"			"70"
			"visible"		"0"
			"bgcolor_override"		"18 20 22 255"
			"noitem_textcolor"		"117 107 94 255"
			"PaintBackgroundType"	"0"
			"paintborder"	"1"
			
			"model_center_x"	"1"
			"model_ypos"		"5"			
			"model_tall"		"55"
			"model_wide"		"82"
			"text_ypos"			"54"
			"text_center"		"1"
			"name_only"			"1"
			
			// PANEL TEMPLATE: Uses the Items body face for live item attributes while preserving their native quality and attribute colours.
			"attriblabel"
			{
				"font"			"CompHUDItemsBody"
				"visible"		"0"
			}
			
			// PANEL TEMPLATE: Defines the reusable item-preview surface instantiated inside the modelpanels KeyValues control.
			"itemmodelpanel"
			{
				"use_item_rendertarget" "0"
				"allow_rot"				"0"
			}
			"RoundedCorners" "0"
			"paintbackground" "1"
		}

		// PANEL TEMPLATE: Styles the native item-options action with neutral and orange states while retaining runtime slot commands.
		"itemoptionpanels_kv"
		{
			"ControlName"	"CExButton"
			"xpos"			"0"
			"ypos"			"0"
			"zpos"			"1"
			"wide"			"14"
			"tall"			"14"
			"autoResize"	"0"
			"visible"		"0"
			"enabled"		"1"
			"tabPosition"	"0"
			"labelText"		"+"
			"font"			"CompHUDItemsAction"
			"textAlignment"	"center"
			"dulltext"		"0"
			"brighttext"	"0"
