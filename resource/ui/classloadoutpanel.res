	// PANEL: Reuses the main-menu rotating emblem as a translucent backdrop centred behind the player model and below every loadout control.
	"CompHUDLoadoutEmblem"
	{
		"ControlName" "ImagePanel"
		"fieldName" "CompHUDLoadoutEmblem"
