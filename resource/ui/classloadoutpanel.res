	}

	// PANEL: Renders the interactive class preview transparently above the rotating emblem while preserving the native camera, equipment and model controls.
	"classmodelpanel"
	{
		"ControlName"	"CTFPlayerModelPanel"
		"fieldName"		"classmodelpanel"
		
