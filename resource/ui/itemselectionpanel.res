// RESOURCE: Declares the itemselectionpanel VGUI control tree that TF2 loads for this interface.
"Resource/UI/ItemSelectionPanel.res"
{
	// PANEL: Hosts the native equip picker on a flat charcoal surface while preserving its slot, selection, and backpack layout bindings.
	"ItemSelectionPanel"
	{
		"ControlName"	"EditablePanel"
		"fieldName"		"ItemSelectionPanel"
		"xpos"			"0"
		"ypos"			"0"
		"zpos"			"500"
		"wide"			"f0"
		"tall"			"480"
		"autoResize"	"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"tabPosition"	"0"
		"settitlebarvisible"	"0"
		"bgcolor_override"	"32 34 36 255"
		
		"item_ypos"		"60"
		"item_ydelta"	"80"
		"item_backpack_offcenter_x"		"-288"
		"item_backpack_xdelta"			"4"
		"item_backpack_ydelta"			"3"

		// PANEL TEMPLATE: Defines reusable modelpanels selection KeyValues controls instantiated by the item selection panel.
		"modelpanels_selection_kv"
		{
			"wide"				"94"
			"tall"				"70"
			"model_xpos"		"2"
			"model_wide"		"75"
			"model_tall"		"50"
			"model_center_x"	"1"
			"text_ypos"			"0"
			"text_forcesize"	"2"
			"text_center"		"0"
			"text_yoffset"		"2"
			"inset_eq_y"		"55"

			"deferred_description"	"1"
			"deferred_icon"			"1"
		}
		// PANEL TEMPLATE: Draws the native item card on a square near-black grey fill while preserving item models, quality colours and runtime state bindings.
		"modelpanels_kv"
		{
			"ControlName"	"CItemModelPanel"
			"xpos"			"c-70"
			"ypos"			"270"
			"wide"			"54"
			"tall"			"42"
			"visible"		"0"
			"bgcolor_override"		"18 20 22 255"
			"noitem_textcolor"		"117 107 94 255"
			"PaintBackgroundType"	"0"
			"paintborder"	"1"
			
			"model_xpos"	"2"
			"model_ypos"	"5" 
			"model_wide"	"50"
			"model_tall"	"35"
			"text_ypos"		"60"
			"text_center"	"1"
			"name_only"		"1"
			
			"inset_eq_x"	"4"
			"inset_eq_y"	"2"

			"deferred_description"	"1"
			
			// PANEL TEMPLATE: Defines the reusable item-preview surface instantiated inside the modelpanels KeyValues control.
			"itemmodelpanel"
			{
				"use_item_rendertarget" "0"
				"allow_rot"				"0"
			}
			
			"use_item_sounds"	"1"
			"RoundedCorners" "0"
			"paintbackground" "1"
		}
		// PANEL TEMPLATE: Presents native duplicate counts in the compact HUD body face while retaining their blue status colour.
		"duplicatelabels_kv"
		{
			"font"			"CompHUDItemsBodySmall"
			"textAlignment"	"center"
			"wide"			"20"
