// RESOURCE: Declares the hudhealthaccountbase VGUI control tree that TF2 loads for this interface.
"Resource/UI/HudHealthAccount.res"
{
	// PANEL: Hosts the healing number feedback emitted when the local player gains health.
	"CHealthAccountPanel"
	{
		"fieldName"				"CHealthAccountPanel"
		"delta_item_x"			"0"
		"delta_item_start_y"	"80"
		"delta_item_end_y"		"80"
		"PositiveColor"			"Garm3nHUDRealGreen"
		"NegativeColor"			"Garm3nHUDRed"
		"delta_lifetime"		"0.8"
		"delta_item_font"		"Garm3nFontAccount"
	}
}
