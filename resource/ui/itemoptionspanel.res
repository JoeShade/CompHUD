// RESOURCE: Styles native class-loadout item options while preserving style and particle-setting actions.
"Resource/UI/ItemOptionsPanel.res"
{
	// PANEL: Keeps the native dynamically populated item-options list and its scrolling behaviour.
	"PanelListPanel"
	{
		"ControlName"	"CPanelListPanel"
		"fieldName"		"PanelListPanel"
		"xpos"		"0"
		"ypos"		"0"
		"wide"		"f-19"
		"tall"		"f0"
		"autoResize"		"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"tabPosition"		"0"
		"proportionalToParent"	"1"
		"autohide_scrollbar"	"1"
		"bgcolor_override"		"0 0 0 0"

		// PANEL: Labels the native particle-origin option with Items typography while preserving its checkbox and command.
		"HatUseHeadCheckButton"
		{
			"ControlName"		"CheckButton"
			"fieldName"		"HatUseHeadCheckButton"
			"xpos"			"0"
			"ypos"			"0"
			"wide"		"140"
			"tall"		"20"
			"autoResize"		"0"
			"pinCorner"		"0"
			"RoundedCorners"		"15"
			"pin_corner_to_sibling"		"0"
			"pin_to_sibling_corner"		"0"
			"visible"		"0"
			"enabled"		"1"
			"tabPosition"		"0"
			"labelText"		"#GameUI_ParticleHatUseHead"
			"textAlignment"		"west"
			"dulltext"		"0"
			"brighttext"		"1"
			"wrap"		"0"
			"centerwrap"		"0"
			"textinsetx"		"6"
			"textinsety"		"0"
			"auto_wide_tocontents"		"0"
			"use_proportional_insets"		"0"
			"Default"		"0"
			"Command"		"particle_use_head_clicked"
			"font" "CompHUDItemsBodySmall"
			"defaultFgColor_override" "255 255 255 255"
			"armedFgColor_override" "225 90 20 255"
			"selectedFgColor_override" "255 255 255 255"
			"depressedFgColor_override" "255 255 255 255"
		}
	
		// PANEL: Accents the native particle-height slider.
		"HatParticleSlider"
		{
			"ControlName"		"CCvarSlider"
			"fieldName"		"HatParticleSlider"
			"xpos"			"0"
			"ypos"			"0"
			"wide"		"140"
			"tall"		"14"
			"autoResize"		"0"
			"RoundedCorners"		"15"
			"visible"		"0"
			"enabled"		"1"
			"tabPosition"		"0"
			"fgcolor_override" "225 90 20 255"
		}

		// PANEL: Opens native item-style selection with neutral and orange Items action states.
		"SetStyleButton"
		{
			"ControlName"	"CExButton"
			"fieldName"		"SetStyleButton"
			"xpos"			"0"
			"ypos"			"0"
			"wide"			"140"
			"tall"			"14"
			"autoResize"	"0"
			"pinCorner"		"3"
			"visible"		"0"
			"enabled"		"1"
			"tabPosition"	"0"
			"labelText"		"#TF_Item_SelectStyle"
			"font"			"CompHUDItemsAction"
			"textAlignment"	"center"
			"dulltext"		"0"
			"brighttext"	"0"
			"default"		"1"
			"sound_depressed"	"UI/buttonclick.wav"
			"sound_released"	"UI/buttonclickrelease.wav"
			"Command"		"set_style"
			"defaultFgColor_override" "255 255 255 255"
			"armedFgColor_override" "255 255 255 255"
			"depressedFgColor_override" "255 255 255 255"
			"selectedFgColor_override" "255 255 255 255"
			"defaultBgColor_override" "54 57 60 255"
			"armedBgColor_override" "225 90 20 255"
			"depressedBgColor_override" "180 70 15 255"
			"selectedBgColor_override" "225 90 20 255"
			"paintbackground" "1"
			"PaintBackgroundType" "0"
			"paintborder" "0"
			"border_default" ""
			"border_armed" ""
			"border_depressed" ""
		}
	}
}
