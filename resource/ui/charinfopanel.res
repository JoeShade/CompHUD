// RESOURCE: Frames the Items pages with scoped HUD typography, a continuous charcoal surface, and native navigation.
"Resource/UI/CharInfoPanel.res"
{
	// PANEL: Hosts the native Items property sheet on opaque charcoal with the HUD title face.
	"character_info"
	{
		"ControlName"	"EditablePanel"
		"fieldName"		"character_info"
		"xpos"			"0"
		"ypos"			"0"
		"wide"			"f0"
		"tall"			"480"
		"autoResize"	"0"
		"pinCorner"		"0"
		"visible"		"1"
		"enabled"		"1"
		"tabPosition"	"0"
		"settitlebarvisible"	"1"
		"PaintBackgroundType"	"0"
		"bgcolor_override"				"32 34 36 255"
		"infocus_bgcolor_override"		"32 34 36 255"
		"outoffocus_bgcolor_override"	"32 34 36 255"
		
		"title"			"#CharInfoAndSetup"
		"title_font"	"CompHUDItemsTitle"
		"titletextinsetX"	"40"
		"titletextinsetY"	"0"
		"titlebarfgcolor_override"				"255 255 255 255"
		"titlebardisabledfgcolor_override"		"255 255 255 255"
		"titlebarbgcolor_override"				"32 34 36 255"
		
		"clientinsetx_override"			"0"
		"sheetinset_bottom"				"40"
		"border" ""
		"paintborder" "0"
		"paintbackground" "1"
	}
	
	// ImagePanel paints fillcolor; transparent drawcolor also suppresses artwork cached before a HUD reload.
	// PANEL: Retains the native header bounds as a flat charcoal surface.
	"BackgroundHeader"
	{
		"ControlName"	"ImagePanel"
		"fieldName"		"BackgroundHeader"
		"xpos"			"0"
		"ypos"			"0"
		"zpos"			"-2"
		"wide"			"f0"
		"tall"			"120"
		"visible"		"1"
		"enabled"		"1"
		"image"			""
		"tileImage"		"1"
		"border" ""
		"paintborder" "0"
		"PaintBackgroundType" "0"
		"paintbackground" "1"
		"bgcolor_override" "32 34 36 255"
		"fillcolor" "32 34 36 255"
		"drawcolor" "0 0 0 0"
	}				
	// ImagePanel paints fillcolor; transparent drawcolor also suppresses artwork cached before a HUD reload.
	// PANEL: Retains the native footer bounds as a flat charcoal surface.
	"BackgroundFooter"
	{
		"ControlName"	"ImagePanel"
		"fieldName"		"BackgroundFooter"
		"xpos"			"0"
		"ypos"			"420"
		"zpos"			"1"
		"wide"			"f0"
		"tall"			"60"
