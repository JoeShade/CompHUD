		"border" ""
		"paintborder" "0"
		"PaintBackgroundType" "0"
		"paintbackground" "1"
		"bgcolor_override" "32 34 36 255"
		"fillcolor" "32 34 36 255"
		"drawcolor" "0 0 0 0"
	}				
	// ImagePanel paints fillcolor; transparent drawcolor also suppresses artwork cached before a HUD reload.
	// PANEL: Separates the native navigation band from Items content with the HUD orange accent.
	"FooterLine"
	{
		"ControlName"	"ImagePanel"
		"fieldName"		"FooterLine"
		"xpos"			"0"
		"ypos"			"420"
		"zpos"			"2"
		"wide"			"f0"
		"tall"			"2"
