		"bgcolor_override" "225 90 20 255"
		"fillcolor" "225 90 20 255"
		"drawcolor" "0 0 0 0"
	}				
	
	// PANEL: Groups and positions the child controls that compose the sheet area of the charinfopanel interface.
	"Sheet"
	{
		"ControlName"	"EditablePanel"
		"fieldName"		"Sheet"
		"tabxindent"	"80"
		"tabxdelta"		"10"
		"tabwidth"		"240"
		"tabheight"		"20"
		"transition_time" "0"
		"yoffset"	"14"
		
		// ImagePanel paints fillcolor; transparent drawcolor also suppresses artwork cached before a HUD reload.
		// PANEL: Separates the native navigation band from Items content with the HUD orange accent.
		"HeaderLine"
		{
			"ControlName"	"ImagePanel"
			"fieldName"		"HeaderLine"
			"xpos"			"0"
			"ypos"			"32"
			"zpos"			"5"
			"wide"			"f0"
			"tall"			"2"
