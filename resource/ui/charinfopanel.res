		"RoundedCorners" "0"
	}

	// PANEL: Closes the native Items screen using the dashboard red dismissal states.
	"CloseButton"
	{
		"ControlName"	"CExButton"
		"fieldName"		"CloseButton"
		"xpos"			"c+195"
		"ypos"			"437"
		"zpos"			"2"
		"wide"			"100"
		"tall"			"25"
