	// PANEL: Provides the back keyboard button action and forwards its configured command to TF2 when selected. It stays off-screen to preserve the engine binding.
	"BackKeyboardButton"
	{
		"ControlName"	"CExButton"
		"fieldName"		"BackKeyboardButton"
		"xpos"			"99999"
		"ypos"			"437"
		"zpos"			"2"
		"wide"			"100"
		"tall"			"25"
		"autoResize"	"0"
		"pinCorner"		"3"
		"visible"		"1"
		"enabled"		"1"
		"tabPosition"	"0"
