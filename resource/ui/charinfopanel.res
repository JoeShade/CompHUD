			"border" ""
			"paintborder" "0"
			"PaintBackgroundType" "0"
			"paintbackground" "1"
			"bgcolor_override" "225 90 20 255"
			"fillcolor" "225 90 20 255"
			"drawcolor" "0 0 0 0"
		}				
		
		// PANEL TEMPLATE: Builds native property-sheet tabs with scoped action text and distinct selected and inactive captions.
		"tabskv"
		{
			"textinsetx"		"40"
			"font"				"CompHUDItemsAction"
			"selectedcolor"		"255 255 255 255"
			"unselectedcolor"	"170 170 170 255"	
			"defaultBgColor_override"	"32 34 36 255"
			"paintbackground"	"0"
			"activeborder_override"	""
			"normalborder_override" ""
			"paintborder" "0"
		}
	}
	
	// PANEL: Returns to the preceding Items page with neutral and orange navigation states.
	"BackButton"
	{
		"ControlName"	"CExButton"
		"fieldName"		"BackButton"
		"xpos"			"c-295"
		"ypos"			"437"
		"zpos"			"2"
		"wide"			"100"
		"tall"			"25"
