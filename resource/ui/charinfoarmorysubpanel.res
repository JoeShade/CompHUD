// RESOURCE: Styles the native Items catalog while preserving item quality, attributes, filters, models, links, and paging contracts.
"Resource/UI/CharInfoArmorySubPanel.res"
{
	// PANEL: Hosts the native item catalog on charcoal and supplies neutral, hover-orange, and selected-orange thumbnail states.
	"armory_panel"
	{
		"ControlName"	"Frame"
		"fieldName"		"armory_panel"
		"wide"			"f0"
		"zpos"			"501"
		"visible"		"1"
		"autoResize"	"0"
		"pinCorner"		"0"
		"enabled"		"1"
		"tabPosition"	"0"
		"settitlebarvisible"	"0"
		"PaintBackgroundType"	"0"
		"bgcolor_override"	"32 34 36 255"
		"infocus_bgcolor_override" "32 34 36 255"
		"outoffocus_bgcolor_override" "32 34 36 255"
		
		"thumbnail_bgcolor"			"18 20 22 255"
		"thumbnail_bgcolor_mouseover"	"225 90 20 255"
		"thumbnail_bgcolor_selected"	"180 70 15 255"
		
		"thumbnails_rows"		"4"
		"thumbnails_columns"	"4"
		
		"thumbnails_x"			"c-300"
		"thumbnails_y"			"60"
		"thumbnails_delta_x"	"8"
		"thumbnails_delta_y"	"8"
		
		// PANEL TEMPLATE: Draws the native item card on a square near-black grey fill while preserving item models, quality colours and runtime state bindings.
		"thumbnail_modelpanels_kv"
		{
			"ControlName"	"CItemModelPanel"
			"zpos"			"13"
			"wide"			"70"
			"tall"			"49"
			"visible"		"0"
			"bgcolor_override"		"18 20 22 255"
			"noitem_textcolor"		"117 107 94 255"
			"PaintBackgroundType"	"0"
			"paintborder"	"0"
			
			"model_xpos"	"7"
			"model_ypos"	"5"
			"model_wide"	"58"
			"model_tall"	"38"
			"text_ypos"		"60"
			"text_center"	"1"
			"name_only"		"1"
			
			"inset_eq_x"	"2"
			"inset_eq_y"	"2"
			
			// PANEL TEMPLATE: Preserves the native embedded item-rendering settings and inventory-image behaviour.
			"itemmodelpanel"
			{
				"use_item_rendertarget" "0"
				"allow_rot"				"0"
			}
			"RoundedCorners" "0"
			"paintbackground" "1"
		}
		"paintbackground" "1"
		"paintborder" "0"
		"border" ""
	}

