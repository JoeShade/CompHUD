#base "matchmakingdashboardsidepanel.res"

// RESOURCE: Defines the native matchmaking control tree with HUD-scoped typography.
"Resource/UI/MatchMakingDashboardMvMCriteria.res"
{
	// PANEL: Hosts a full-width opaque matchmaking page below the dashboard; TF2 retains its native stack and slide lifecycle.
	"MVMCriteria"
	{
		"fieldName"		"MVMCriteria"
		"xpos"			"r0"
		"ypos"			"24"
		"zpos"			"11002"
		"wide"			"f0"
		"tall"			"f24"
		"visible"		"1"
		"proportionaltoparent"	"1"
	}

	// PANEL: Keeps native runtime content as a direct child in a centered fixed-width column, reserving the bottom navigation row.
	"criteria"
	{
		"ControlName"	"CMVMCriteriaPanel"
		"fieldName"		"criteria"
		"xpos"			"cs-0.5"
		"ypos"			"15"
		"zpos"			"100"
		"wide"			"410"
		"tall"			"f86"
		"visible"		"1"
		"proportionaltoparent"	"1"

		"pinCorner"		"2"
	}

	// PANEL: Retains the native back action with white HUD text and neutral-to-orange interaction states.
	"BackButton"
	{
		"ControlName"	"CExButton"
