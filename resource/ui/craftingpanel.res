// RESOURCE: Loads the native crafting workspace with scoped Items typography and surfaces.
"Resource/UI/CraftingPanel.res"
{
	// PANEL: Hosts native material slots, blueprint filters, and recipe templates on the charcoal Items surface.
	"crafting_panel"
	{
		"ControlName"	"Frame"
		"fieldName"		"crafting_panel"
		"xpos"			"0"
		"ypos"			"0"
		"wide"			"f0"
		"tall"			"400"
		"zpos"			"501"
		"visible"		"1"
		"autoResize"	"0"
		"pinCorner"		"0"
		"enabled"		"1"
		"tabPosition"	"0"
		"settitlebarvisible"	"0"
		"PaintBackgroundType"	"0"
		"bgcolor_override"	"32 34 36 255"
		"infocus_bgcolor_override" "32 34 36 255"
		"outoffocus_bgcolor_override" "32 34 36 255"

		"item_ypos"						"85"
		"output_item_ypos"				"255"		
		"item_crafting_offcenter_x"		"0"
		"item_backpack_xdelta"			"2"
		"item_backpack_ydelta"			"4"

		"button_xpos_offcenter"			"175"		
		"button_ypos"					"85"
		"button_ydelta"					"80"
		"button_override_delete_xpos"	"0"
		
		// PANEL TEMPLATE: Draws the native item card on a square near-black grey fill while preserving item models, quality colours and runtime state bindings.
		"modelpanels_kv"
		{
			"ControlName"	"CItemModelPanel"
			"wide"			"70"
			"tall"			"45"
			"visible"		"0"
			"bgcolor_override"		"18 20 22 255"
			"noitem_textcolor"		"117 107 94 255"
			"PaintBackgroundType"	"0"
			"paintborder"	"1"
			
			"model_ypos"	"5"
			"model_tall"	"35"
			"text_center"	"1"
			"name_only"		"1"
			"text_forcesize" "3"
			"noitem_use_fullpanel" "1"
			
			"inset_eq_x"	"2"
			"inset_eq_y"	"2"

			// PANEL: Keeps item model previews and their native name labels aligned within each material slot.
			"MainContentsContainer"
			{
				"ControlName"	"EditablePanel"
				"fieldName"		"MainContentsContainer"
				"xpos"			"0"
				"ypos"			"0"
				"wide"			"f0"
				"tall"			"f0"
				"visible"		"1"
				"bgcolor_override"		"0 0 0 0"
			
				// PANEL: Preserves the native item render target and rotation settings for crafting previews.
				"itemmodelpanel"
				{
					"use_item_rendertarget" "0"
					"allow_rot"				"0"
				}
			
				// PANEL: Displays the runtime material name using native item styling and wrapping.
				"namelabel"
				{
					"ControlName"	"CExLabel"
					"fieldName"		"namelabel"
					"xpos"			"0"
					"ypos"			"0"
					"zpos"			"2"
					"wide"			"50"
					"tall"			"30"
					"autoResize"	"0"
					"pinCorner"		"0"
					"visible"		"1"
					"enabled"		"1"
					"labelText"		"%itemname%"
					"textAlignment"	"south"
					"fgcolor"		"235 226 202 255"
					"wrap"			"1"
					"centerwrap"	"1"
				}
			}
			"RoundedCorners" "0"
			"paintbackground" "1"
		}
		
		// PANEL TEMPLATE: Templates square runtime blueprint rows with inset vertically centred Items text and a depressed highlight for the selected recipe.
		"recipebuttons_kv"
		{
			"font"			"CompHUDItemsBodySmall"
			"xpos"			"0"
			"ypos"			"0"
			"zpos"			"1"
			"wide"			"280"
			"tall"			"13"
			"autoResize"	"0"
			"pinCorner"		"0"
			"visible"		"1"
			"wrap"			"0"
			"centerwrap"	"0"
			"textAlignment" "west"
			"textinsetx"	"6"
			"defaultFgColor_override" "255 255 255 255"
			"defaultBgColor_override" "54 57 60 255"
			"armedFgColor_override" "255 255 255 255"
			"armedBgColor_override" "225 90 20 255"
			"depressedFgColor_override" "255 255 255 255"
			"depressedBgColor_override" "180 70 15 255"
			"paintbackground"	"1"
			"PaintBackgroundType"	"0"
			"paintborder"	"0"
			"selectedFgColor_override"	"255 255 255 255"
			"disabledFgColor_override"	"150 150 150 255"
			"selectedBgColor_override"	"225 90 20 255"
			"disabledBgColor_override"	"42 44 46 255"
			"RoundedCorners" "0"
		}
		
		"filter_xoffset"	"-290"
		"filter_ypos"		"30"
		"filter_xdelta"		"10"
		"filter_ydelta"		"10"
		
		// PANEL TEMPLATE: Preserves native blueprint category images, MenuKeys glyphs, and runtime filter commands.
		"recipefilterbuttons_kv"
		{
			"zpos"				"2"
			"wide"				"30"
			"tall"				"30"
			"autoResize"		"0"
			"pinCorner"			"0"
			"visible"			"1"
			"enabled"			"1"
			"tabPosition"		"0"
			"labelText"			""
			"textAlignment"		"south-west"
			"Command"			""
			"Default"			"0"
			"font"				"MenuKeys"
			"scaleImage"		"1"
			"sound_depressed"	"UI/buttonclick.wav"
			"sound_released"	"UI/buttonclickrelease.wav"
		}	
	}
	
